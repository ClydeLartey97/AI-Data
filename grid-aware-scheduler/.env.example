# Copy this file to `.env` and fill in the values. `.env` is gitignored;
# this example is not, and must never contain a real key.
#
#   cp .env.example .env
#
# Existing environment variables always win over this file, so exporting a key
# in your shell overrides whatever is here.

# Renewables.ninja — simulated PV and wind output, used to score the local
# generation model in core/renewables.py. Free personal token:
#   register at https://www.renewables.ninja/register
#   token shown at https://www.renewables.ninja/profile
# Rate limits are 50 requests an hour and one a second.
RENEWABLES_NINJA_TOKEN=

# PJM day-ahead LMP — free registered subscription key from
# https://apiportal.pjm.com. Not yet wired to an adapter; see HANDOFF item 21.
# PJM_SUBSCRIPTION_KEY=
