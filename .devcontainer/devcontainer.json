{
  "name": "grid-aware-scheduler",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // The Python project lives in a subfolder of this repository, so the install
  // has to be run there rather than at the workspace root.
  //
  // The `apple` extra is deliberately NOT installed: MLX ships no Linux wheels
  // and a Codespace is x86-64 Linux. Nothing here needs it. MLX only ever
  // *produces* measured Apple profiles, and the one measurement this project
  // owns is baked into `hardware/derive.py` as MEASURED_M2, so every scaling,
  // planning and market path works with no Apple hardware present.
  "postCreateCommand": "pip install --upgrade pip && pip install -e './grid-aware-scheduler[dev]'",

  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Grid-Aware Scheduler",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["grid-aware-scheduler/tests"],
        "python.analysis.extraPaths": ["grid-aware-scheduler"]
      }
    }
  },

  "remoteEnv": {
    // The GB adapter imports a sibling checkout that is not in this repository
    // and never will be. Pointing this at a path that does not exist is honest
    // rather than broken: the deferred import raises a message naming this
    // variable, and CAISO, NYISO, MISO and ERCOT are entirely unaffected.
    "NATIONAL_GRID_TOOL_PATH": "/workspaces/National-Grid-Tool"
  }
}
